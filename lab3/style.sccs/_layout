@use "variables" as v;
@use "mixins" as m;

.site-header {
  min-height: 76px;
  background: rgba(255, 255, 255, .96);
  border-bottom: 1px solid #e5edf3;
  position: relative;
  z-index: 10;

  .header-inner {
    min-height: 76px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: v.$space-md;
  }
}

.hero {
  min-height: 480px;
  overflow: hidden;
  color: v.$color-white;
  background:
    radial-gradient(circle at 12% 15%, rgba(53, 193, 255, .18), transparent 31%),
    linear-gradient(135deg, #081b35 0%, #0c2945 48%, #103d51 100%);

  .hero-grid {
    min-height: 480px;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: v.$space-lg;
    padding-block: v.$space-xl;
  }

  h1 {
    max-width: 650px;
    margin-bottom: 20px;
    font-size: clamp(1.8rem, 6vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -1.8px;

    span {
      color: #55ddb1;
    }
  }

  .hero-text {
    max-width: 570px;
    color: #c6d6e4;
    font-size: 16px;
  }
}

.section {
  padding: clamp(48px, 7vw, 72px) 0;
  background: v.$color-surface;

  &.section-soft {
    background: v.$color-surface-soft;
  }

  &.order-section {
    background: #eaf2f5;
  }
}

.section-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: v.$space-md;
  margin-bottom: 28px;

  &.compact {
    align-items: flex-start;
  }
}

.monitor-grid,
.service-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: v.$space-md;
}

.measurements-layout,
.order-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: v.$space-lg;
  align-items: start;
}

.footer-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: v.$space-lg;
}

@media (min-width: #{v.$bp-tablet}) {
  .site-header .header-inner {
    min-height: 76px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .hero .hero-grid {
    grid-template-columns: 1.1fr .9fr;
    padding-block: 0;
  }

  .section-heading {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;

    &.compact {
      align-items: center;
    }
  }

  .monitor-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .service-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .measurements-layout {
    grid-template-columns: 1fr 2fr;
  }

  .order-grid {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

@media (min-width: #{v.$bp-desktop}) {
  .monitor-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .service-list {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .order-grid {
    grid-template-columns: 2fr 3fr;
  }
}
